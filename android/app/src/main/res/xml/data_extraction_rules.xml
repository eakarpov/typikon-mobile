<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 и новее. Основания — в backup_rules.xml, списки держатся в
     согласии: облачная копия и перенос на новое устройство исключают одно и
     то же. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
