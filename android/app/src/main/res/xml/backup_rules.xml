<?xml version="1.0" encoding="utf-8"?>
<!--
  Что не уезжает в резервную копию (Android 11 и старше; для 12+ то же самое
  лежит в data_extraction_rules.xml, и списки обязаны совпадать).

  Само копирование выключать не за что: настройки чтения и избранное — ровно то,
  что человек хотел бы найти на новом телефоне, а у не вошедшего копия и есть
  единственный способ их не потерять.

  А вот защищённое хранилище копировать нельзя. flutter_secure_storage кладёт
  зашифрованное значение в shared_prefs/FlutterSecureStorage.xml, а ключ к нему —
  в Android Keystore, который не копируется по устройству. Файл без ключа
  приезжает нечитаемым, и попытка его прочесть кончается не пустым значением, а
  исключением. Лежит там одна кука сессии, которая живёт час и берётся заново
  входом, — терять нечего.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
</full-backup-content>
